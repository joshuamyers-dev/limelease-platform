{
  "name": "@limelease/root",
  "version": "1.0.0",
  "description": "A monorepo containing a Next.js web app and an Elixir API",
  "author": "Joshua Nissenbaum <REDACTED_EMAIL>",
  "private": true,
  "pnpm": {
    "workspaces": [
      "packages/*",
      "services/*",
      "apps/*",
      "infra/*"
    ]
  },
  "scripts": {
    "deploy:playwright": "cd limelease/services/playwright && sam build && sam deploy --no-confirm-changeset",
    "start:elixir-api": "cd limelease/services/elixir-api && iex -S mix phx.server",
    "start:nextjs": "pnpm --filter @limelease/nextjs-app dev"
  },
  "dependencies": {
    "@pulumi/digitalocean": "^4.30.2",
    "@pulumi/docker": "^4.5.4",
    "@pulumi/pulumi": "^3.120.0",
    "sst": "ion"
  },
  "resolutions": {
    "ts-invariant": "^0.5.0"
  },
  "preconstruct": {
    "packages": [
      "packages/*",
      "services/*"
    ]
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.138"
  }
}