{
    "name": "@limelease/root",
    "version": "1.0.0",
    "description": "A monorepo containing a Next.js web app and an Elixir API",
    "author": "Joshua Nissenbaum <REDACTED_EMAIL>",
    "private": true,
    "pnpm": {
      "workspaces": [
        "packages/*",
        "services/*",
        "apps/*"
      ]
    },
    "scripts": {
      "start:nextjs": "pnpm --filter @limelease/nextjs-app dev",
      "start:elixir-api": "cd limelease/services/elixir-api && iex -S mix phx.server"
    },
    "dependencies": {
        "sst": "^3.0.13"
    },
    "preconstruct": {
      "packages": [
        "packages/*",
        "services/*"
      ]
    }
  }