{<<"app">>,<<"dataloader">>}.
{<<"build_tools">>,[<<"mix">>]}.
{<<"description">>,<<"Efficient batch loading in Elixir">>}.
{<<"elixir">>,<<"~> 1.12">>}.
{<<"files">>,
 [<<"lib">>,<<"lib/dataloader.ex">>,<<"lib/dataloader">>,
  <<"lib/dataloader/kv.ex">>,<<"lib/dataloader/ecto.ex">>,
  <<"lib/dataloader/source.ex">>,<<"mix.exs">>,<<"README.md">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"links">>,
 [{<<"Changelog">>,<<"https://hexdocs.pm/dataloader/changelog.html">>},
  {<<"GitHub">>,<<"https://github.com/absinthe-graphql/dataloader">>}]}.
{<<"name">>,<<"dataloader">>}.
{<<"requirements">>,
 [[{<<"app">>,<<"telemetry">>},
   {<<"name">>,<<"telemetry">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 1.0">>}],
  [{<<"app">>,<<"ecto">>},
   {<<"name">>,<<"ecto">>},
   {<<"optional">>,true},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<">= 3.4.3 and < 4.0.0">>}],
  [{<<"app">>,<<"opentelemetry_process_propagator">>},
   {<<"name">>,<<"opentelemetry_process_propagator">>},
   {<<"optional">>,true},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 0.2.1">>}]]}.
{<<"version">>,<<"2.0.0">>}.
